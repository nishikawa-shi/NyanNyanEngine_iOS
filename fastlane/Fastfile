# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  APP_IDENTIFIER_DEVELOP = "com.ntetz.ios.NyanNyanEngine.debug"
  APP_IDENTIFIER_PRODUCTION = "com.ntetz.ios.NyanNyanEngine"

  TEAM_ID = "K85M397W48"
  PROJECT = "NyanNyanEngine.xcodeproj"
  SCHEME = "NyanNyanEngine"
  BUILD_DIR = "build"
  ADHOC_DEV_IPA_NAME = "NyanNyanEngine-adhoc-dev.ipa"
  ADHOC_IPA_NAME = "NyanNyanEngine-adhoc.ipa"
  APPSTORE_IPA_NAME = "NyanNyanEngine-appstore.ipa"

  desc "provisioning profile読み取りlane"
  lane :load_certs do
    setup_ci

    match(
      app_identifier: [
        APP_IDENTIFIER_DEVELOP
      ],
      type: "development",
      readonly: true
    )

    match(
      app_identifier: [
        APP_IDENTIFIER_DEVELOP,
        APP_IDENTIFIER_PRODUCTION
      ],
      type: "adhoc",
      readonly: true
    )

    match(
      app_identifier: [
        APP_IDENTIFIER_PRODUCTION
      ],
      type: "appstore",
      readonly: true
    )
  end

  desc "provisioning profileへの端末追加lane"
  lane :add_device_to_profiles do |options|
    if (not options[:name]) || (not options[:udid])
      raise("使い方: bundle exec fastlane add_device_to_profiles name:\"2019's_XSMax\" udid:\"00001111-00011112222A112E\"")
    end

    register_devices(
      devices: {
        options[:name] => options[:udid]
      }
    )

    match(
      app_identifier: [
        APP_IDENTIFIER_DEVELOP
      ],
      type: "development",
      force_for_new_devices: true
    )

    match(
      app_identifier: [
        APP_IDENTIFIER_DEVELOP,
        APP_IDENTIFIER_PRODUCTION
      ],
      type: "adhoc",
      force_for_new_devices: true
    )
  end

  desc "provisioning profile生成lane"
  lane :produce_certs do
    match(
      app_identifier: [
        APP_IDENTIFIER_DEVELOP
      ],
      type: "development",
      readonly: false
    )

    match(
      app_identifier: [
        APP_IDENTIFIER_DEVELOP,
        APP_IDENTIFIER_PRODUCTION
      ],
      type: "adhoc",
      readonly: false
    )

    match(
      app_identifier: [
        APP_IDENTIFIER_PRODUCTION
      ],
      type: "appstore",
      readonly: false
    )
  end

  desc "dev環境向けβ版アプリ配布用のad-hoc署名ipaを作るlane"
  desc "使い方: bundle exec fastlane build_beta_dev build_number:20260823.1"
  desc "事前に load_certs を実行して証明書とprovisioning profileを取得しておくこと"
  lane :build_beta_dev do |options|
    # dev向けだけ Debug 構成を使う。専用のビルド構成を新設しないのは、AppDelegate が
    # #if DEBUG で接続先Firebaseを選ぶ作りになっており、構成と環境が1対1で固定されて
    # いるため。環境と最適化レベルを掛け合わせる軸がこのプロジェクトには存在しない
    build_signed_ipa(
      build_number: options[:build_number],
      configuration: "Debug",
      app_identifier: APP_IDENTIFIER_DEVELOP,
      export_method: "ad-hoc",
      profile_name: "match AdHoc #{APP_IDENTIFIER_DEVELOP}",
      output_name: ADHOC_DEV_IPA_NAME
    )
  end

  desc "prd環境向けβ版アプリ配布用のad-hoc署名ipaを作るlane"
  desc "使い方: bundle exec fastlane build_beta build_number:20260822.1"
  desc "事前に load_certs を実行して証明書とprovisioning profileを取得しておくこと"
  lane :build_beta do |options|
    build_signed_ipa(
      build_number: options[:build_number],
      configuration: "Release",
      app_identifier: APP_IDENTIFIER_PRODUCTION,
      export_method: "ad-hoc",
      profile_name: "match AdHoc #{APP_IDENTIFIER_PRODUCTION}",
      output_name: ADHOC_IPA_NAME
    )
  end

  desc "TestFlight配布用のapp-store署名ipaを作り、App Store Connectへアップロードするlane"
  desc "使い方: bundle exec fastlane upload_ipa_to_testflight build_number:20260822.1"
  desc "事前に load_certs を実行して証明書とprovisioning profileを取得しておくこと"
  lane :upload_ipa_to_testflight do |options|
    build_signed_ipa(
      build_number: options[:build_number],
      configuration: "Release",
      app_identifier: APP_IDENTIFIER_PRODUCTION,
      export_method: "app-store",
      profile_name: "match AppStore #{APP_IDENTIFIER_PRODUCTION}",
      output_name: APPSTORE_IPA_NAME
    )

    # deliverではなくupload_to_testflightを使う。deliverはApp Storeのメタデータも同期するため、
    # 既存アプリレコードの説明文やスクリーンショットを空で上書きする事故が起きうる
    upload_to_testflight(
      api_key_path: "appstore_api_key.json",
      app_identifier: APP_IDENTIFIER_PRODUCTION,
      ipa: "#{BUILD_DIR}/#{APPSTORE_IPA_NAME}",
      skip_waiting_for_build_processing: true
    )
  end

  # provisioning profileの差し替えはエクスポート時の再署名に任せている。xcargsで
  # PROVISIONING_PROFILE_SPECIFIERを上書きするとビルド全体に効いてしまい、profileを
  # 必要としない依存パッケージのターゲットの署名が壊れるため
  private_lane :build_signed_ipa do |options|
    build_number = options[:build_number].to_s
    if build_number.empty?
      raise("引数 build_number が不足しています。: `bundle exec fastlane build_beta build_number:20260822.1`")
    end

    # ONLY_ACTIVE_ARCH を明示するのは、Debug構成がYESを持っているため。ランナーや
    # 開発機のアーキテクチャによって成果物の中身が変わる余地を残さない
    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: options[:configuration],
      export_method: options[:export_method],
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} ONLY_ACTIVE_ARCH=NO -skipPackagePluginValidation",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          options[:app_identifier] => options[:profile_name]
        }
      },
      output_directory: BUILD_DIR,
      output_name: options[:output_name]
    )
  end

end
